# CropFlow Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# PostgreSQL password (used by docker-compose and backend)
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Database password for backend application user
DB_PASSWORD=your_secure_db_password_here

# JWT signing secret (256-bit / 64 hex chars minimum)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_256_bit_jwt_secret_here